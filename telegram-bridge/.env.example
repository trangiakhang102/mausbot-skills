# Sao chép thành .env (chmod 600). KHÔNG đưa lên GitHub, không gửi vào chat.
TELEGRAM_BOT_TOKEN=
# Telegram numeric user id của chủ (ví dụ từ @userinfobot)
ALLOWED_USER_ID=
# Cổng MausBot trên máy này (app thường dùng 8799)
OMB_PORT=8799
# Tuỳ chọn: thời gian chờ tối đa mỗi việc
JOB_TIMEOUT=30m
# Token MausBot không để đây. Nó nằm ở file .omb-token (tạo bằng:
#   ./omb.sh login --name telegram-bridge
#   ./omb.sh token create telegram-bridge --out .omb-token --scope admin --expires 180d
# )
# Id nhóm Telegram nhận danh sách bài (bridge ghi vào groups.json khi thấy nhóm)
GROUP_CHAT_ID=
# Người dùng thêm, hạn chế theo bot (UID:tên hoặc UID:id, cách nhau bằng dấu phẩy)
# EXTRA_USERS=123456789:Bài khoa học
EXTRA_USERS=
